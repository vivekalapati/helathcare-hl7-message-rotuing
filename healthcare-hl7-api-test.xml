    <!-- TEST 11: VALID HL7 POST -->

    <munit:test name="HL7-API-POST-Valid-Test"
                description="Verify valid HL7 message accepted for S3 upload">

        <munit:behavior>
            <munit-tools:mock-when processor="s3:put-object">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Upload HL7 to AWS S3']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[{eTag: 'munit-test-etag'}]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:payload
                    value="#[{messageId: 'MUNITPOST001', hl7Message: 'MSH|^~\&amp;|TEST|HOSPITAL|RECEIVER|HOSPITAL|20261019100000||ADT^A01|MUNITPOST001|P|2.5'}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="post:\hl7\messages:application\json:healthcare-hl7-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[vars.httpStatus]"
                is="#[MunitTools::equalTo(202)]"/>

            <munit-tools:assert-that
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('ACCEPTED')]"/>

            <munit-tools:assert-that
                expression="#[payload.messageId]"
                is="#[MunitTools::equalTo('MUNITPOST001')]"/>

            <munit-tools:assert-that
                expression="#[payload.eventType]"
                is="#[MunitTools::equalTo('A01')]"/>

            <munit-tools:assert-that
                expression="#[payload.s3ObjectKey startsWith 'incoming-hl7/API_']"
                is="#[MunitTools::equalTo(true)]"/>

            <munit-tools:verify-call processor="s3:put-object" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Upload HL7 to AWS S3']"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>


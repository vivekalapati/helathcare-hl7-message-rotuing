                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Get Patient From MySQL']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[[{
                            patient_id: 'PATMUNIT001',
                            patient_key: 'KEY001',
                            mrn: 'MRN001',
                            first_name: 'TEST',
                            middle_name: null,
                            last_name: 'PATIENT',
                            date_of_birth: null,
                            gender: 'M',
                            address_line1: null,
                            city: null,
                            state: null,
                            postal_code: null
                        }]]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <munit:set-event>
                <munit:attributes
                    value="#[{uriParams: {patientId: 'PATMUNIT001'}}]"
                    mediaType="application/java"/>
            </munit:set-event>

            <flow-ref name="get:\patients\(patientId):healthcare-hl7-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.patientId]"
                is="#[MunitTools::equalTo('PATMUNIT001')]"/>

            <munit-tools:assert-that
                expression="#[payload.firstName]"
                is="#[MunitTools::equalTo('TEST')]"/>

            <munit-tools:assert-that
                expression="#[payload.lastName]"
                is="#[MunitTools::equalTo('PATIENT')]"/>

            <munit-tools:assert-that
                expression="#[payload.gender]"
                is="#[MunitTools::equalTo('M')]"/>

            <munit-tools:assert-that
                expression="#[vars.httpStatus default 200]"
                is="#[MunitTools::equalTo(200)]"/>

            <munit-tools:verify-call processor="db:select" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Get Patient From MySQL']"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>


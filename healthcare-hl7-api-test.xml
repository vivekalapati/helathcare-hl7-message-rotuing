      http://www.mulesoft.org/schema/mule/munit-tools http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">

    <munit:config name="healthcare-hl7-api-test.xml"/>

    <!-- TEST 1: HEALTH API -->

    <munit:test name="HL7-API-Health-Test"
                description="Verify Health API response">

        <munit:execution>
            <flow-ref name="get:\health:healthcare-hl7-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.status]"
                is="#[MunitTools::equalTo('UP')]"/>

            <munit-tools:assert-that
                expression="#[payload.application]"
                is="#[MunitTools::equalTo('Healthcare HL7 Message Routing API')]"/>
        </munit:validation>

    </munit:test>

    <!-- TEST 2: MONITORING SUMMARY -->

    <munit:test name="HL7-API-Monitoring-Summary-Test"
                description="Verify monitoring statistics">

        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Get Monitoring Statistics']"/>
                </munit-tools:with-attributes>

                <munit-tools:then-return>
                    <munit-tools:payload
                        value="#[[{
                            totalReceived: 100,
                            processed: 80,
                            quarantined: 10,
                            duplicates: 0,
                            processingFailures: 5,
                            superseded: 3,
                            unknownStatus: 2
                        }]]"
                        mediaType="application/java"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>

        <munit:execution>
            <flow-ref name="get:\monitoring\summary:healthcare-hl7-api-config"/>
        </munit:execution>

        <munit:validation>
            <munit-tools:assert-that
                expression="#[payload.totalReceived]"
                is="#[MunitTools::equalTo(100)]"/>

            <munit-tools:assert-that
                expression="#[payload.processed]"
                is="#[MunitTools::equalTo(80)]"/>

            <munit-tools:assert-that
                expression="#[payload.quarantined]"
                is="#[MunitTools::equalTo(10)]"/>

            <munit-tools:assert-that
                expression="#[payload.processingFailures]"
                is="#[MunitTools::equalTo(5)]"/>

            <munit-tools:verify-call processor="db:select" times="1">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute
                        attributeName="doc:name"
                        whereValue="#['Get Monitoring Statistics']"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>

    </munit:test>

    <!-- TEST 3: PATIENT FOUND -->

    <munit:test name="HL7-API-Patient-Found-Test"
                description="Verify existing patient details">

        <munit:behavior>
